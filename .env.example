# Copy to .env and adjust. Every value has a working default for local development.

DATABASE_URL=postgresql+asyncpg://docforge@localhost:5503/docforge
REDIS_URL=redis://:docforge-dev@localhost:6403/0
CORS_ORIGINS=["http://localhost:3103"]

# Bearer token -> reviewer name for every write (start runs, replay, review decisions).
# Leave unset locally: writes are then accepted from loopback only (the Next.js proxy).
# API_TOKENS={"change-me-local-token":"maya.chen"}
# Abandoned runs are re-enqueued by the worker's reaper after this many seconds.
RUN_STALE_AFTER_SECONDS=900
LOG_LEVEL=INFO
LOG_JSON=false

# Where the filesystem source reads documents from. `make seed` copies sample-corpus/ here.
FS_SOURCE_ROOT=./data/inbox
DATA_DIR=./data

# Optional S3-compatible source (MinIO in docker-compose). Enabled when an endpoint or key is set.
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=docforge-inbox
# S3_PREFIX=
# S3_ACCESS_KEY_ID=docforge
# S3_SECRET_ACCESS_KEY=docforge-secret

# Extraction. "auto" uses Claude when ANTHROPIC_API_KEY is set and the offline rules provider otherwise.
LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=medium
EXTRACTION_MAX_REPAIRS=2
EXTRACTION_REFUSAL_FALLBACK=true
REVIEW_CONFIDENCE_THRESHOLD=0.8

# Embeddings. "auto" uses fastembed (BAAI/bge-small-en-v1.5, downloaded once) and falls back to hashing.
EMBEDDING_PROVIDER=auto
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

CHUNK_MAX_TOKENS=320
STAGE_MAX_ATTEMPTS=3
WORKER_MAX_JOBS=4
SCHEDULED_SCAN_ENABLED=false
SCHEDULED_SCAN_MINUTE_INTERVAL=15

# Web (Next.js) proxies /api/* to this origin, adding the token server-side when set.
DOCFORGE_API_ORIGIN=http://localhost:8103
# DOCFORGE_API_TOKEN=change-me-local-token

# Extra extraction schemas: modules exposing SCHEMAS: list[SchemaSpec].
# SCHEMA_MODULES=["my_company.schemas"]
